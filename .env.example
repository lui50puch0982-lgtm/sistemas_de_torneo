# ========================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ========================================================

# Clave secreta para cookies y sesiones de Flask (generar una segura en producción con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=tu_clave_secreta_super_segura_aqui

# Ruta a la base de datos SQLite
# En desarrollo local: torneo.db o ./instance/torneo.db
# En producción Render con Persistent Disk: /data/database.sqlite (o /data/torneo.db)
DATABASE_PATH=torneo.db

# Flask Environment (opcional)
FLASK_DEBUG=0
